# Sanjivani Assessment Portal — Frontend Environment Variables
# Copy this to .env and fill in your values

# Supabase project URL (from Settings > API in Supabase Dashboard)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase anonymous key (public, safe for frontend)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Backend API base URL (your Render deployment)
# Local dev: http://localhost:3000/api
# Production: https://your-backend.onrender.com/api
VITE_API_URL=http://localhost:3000/api
